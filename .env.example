# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowpilot

# Redis
REDIS_URL=redis://localhost:6379

# Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# Google OAuth
# Get these from your Google Cloud OAuth 2.0 Web application credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Production example:
# GOOGLE_OAUTH_REDIRECT_URI=https://your-production-domain.com/api/integrations/google/callback
GOOGLE_OAUTH_REDIRECT_URI=

# HubSpot OAuth / Projects app
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REDIRECT_URI=https://your-production-domain.com/api/integrations/hubspot/callback
# Space-separated scopes configured in your HubSpot app.
HUBSPOT_OAUTH_SCOPES=oauth crm.objects.contacts.read crm.objects.contacts.write crm.objects.companies.read crm.objects.companies.write crm.objects.deals.read crm.objects.deals.write
